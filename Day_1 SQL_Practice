-- Q1. Find employees who earn more than 40000.
SELECT name, salary
FROM employees
WHERE salary > 40000;


-- Q2. Find employees who earn more than 35000
-- and display salary in descending order.
SELECT name, salary
FROM employees
WHERE salary > 35000
ORDER BY salary DESC;


-- Q3. Display unique department IDs from employees.
SELECT DISTINCT department_id
FROM employees;


-- Q4. Find the average salary of each department.
SELECT
    department_id,
    AVG(salary) AS average_salary
FROM employees
GROUP BY department_id;


-- Q5. Find departments whose average salary is
-- greater than 40000.
SELECT
    department_id,
    AVG(salary) AS average_salary
FROM employees
GROUP BY department_id
HAVING AVG(salary) > 40000;


-- Q6. Display employee names and their department names.
SELECT
    e.name,
    d.department_name
FROM employees e
INNER JOIN departments d
    ON e.department_id = d.department_id;


-- Q7. Find employees whose salary is greater than 40000
-- and display their department names.
SELECT
    e.name,
    e.salary,
    d.department_name
FROM employees e
INNER JOIN departments d
    ON e.department_id = d.department_id
WHERE e.salary > 40000;


-- Q8. Display all departments, including departments
-- that have no employees.
SELECT
    d.department_name,
    e.name
FROM departments d
LEFT JOIN employees e
    ON d.department_id = e.department_id;


-- Q9. Display all employees, even if they do not
-- have a matching department.
SELECT
    e.name,
    d.department_name
FROM employees e
LEFT JOIN departments d
    ON e.department_id = d.department_id;


-- Q10. Display employees whose department exists.
SELECT
    e.name,
    d.department_name
FROM employees e
INNER JOIN departments d
    ON e.department_id = d.department_id;


-- Q11. Display employee name, salary, department name
-- and city using three tables.
SELECT
    e.name,
    e.salary,
    d.department_name,
    l.city
FROM employees e
INNER JOIN departments d
    ON e.department_id = d.department_id
INNER JOIN locations l
    ON d.location_id = l.location_id;


-- Q12. Find the total salary of each department.
SELECT
    d.department_name,
    SUM(e.salary) AS total_salary
FROM employees e
INNER JOIN departments d
    ON e.department_id = d.department_id
GROUP BY d.department_name;


-- Q13. Find departments whose total salary
-- is greater than 70000.
SELECT
    d.department_name,
    SUM(e.salary) AS total_salary
FROM employees e
INNER JOIN departments d
    ON e.department_id = d.department_id
GROUP BY d.department_name
HAVING SUM(e.salary) > 70000;


-- Q14. Count the employees in each department.
SELECT
    d.department_name,
    COUNT(e.employee_id) AS employee_count
FROM employees e
INNER JOIN departments d
    ON e.department_id = d.department_id
GROUP BY d.department_name;


-- Q15. Count employees in every department,
-- including departments with zero employees.
SELECT
    d.department_name,
    COUNT(e.employee_id) AS employee_count
FROM departments d
LEFT JOIN employees e
    ON d.department_id = e.department_id
GROUP BY d.department_name;


-- Q16. Display department name and employee salary
-- for employees earning more than 40000,
-- ordered by salary descending.
SELECT
    d.department_name,
    e.salary
FROM employees e
INNER JOIN departments d
    ON e.department_id = d.department_id
WHERE e.salary > 40000
ORDER BY e.salary DESC;


-- Q17. Find departments that have more than
-- one employee.
SELECT
    d.department_name,
    COUNT(e.employee_id) AS employee_count
FROM employees e
INNER JOIN departments d
    ON e.department_id = d.department_id
GROUP BY d.department_name
HAVING COUNT(e.employee_id) > 1;


-- Q18. Find employees whose salary is greater than
-- the company's average salary and display their
-- name, salary, and department name.
SELECT
    e.name,
    e.salary,
    d.department_name
FROM employees e
INNER JOIN departments d
    ON e.department_id = d.department_id
WHERE e.salary > (
    SELECT AVG(salary)
    FROM employees
);
